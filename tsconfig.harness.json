// Typecheck project for scripts/browser-harness/.
//
// Split out of tsconfig.scripts.json for the same reason tsconfig.tests.json
// was split out of tsconfig.server.json: DOM is contagious, and it is only
// correct for part of the tree.
//
// A harness drives a real browser, so its page.evaluate() callbacks are
// browser code living in a Bun file - ga-report-verify.ts alone reads
// document, window, location, history and PopStateEvent. Without lib.dom that
// is 10 errors (measured 2026-08-09). With it, the harnesses are clean and the
// DOM types stay out of the terminal scripts next door, where they would
// shadow Bun's own.
{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.harness.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["scripts/browser-harness/**/*.ts"]
}
