# deps
node_modules/

dist/

.env
.env.prod
.wallgame-bot-heartbeat

ignore/
# Repo-root scratch space for local review artifacts and one-off evidence files.
# Anchored with a leading slash so it covers only this directory, not every folder
# named tmp elsewhere in the tree.
/tmp/
**/.tanstack/tmp/
.cursor/debug.log
.eslintcache
diff.txt
deep-wallwars/data_*/
deep-wallwars/logs/
deep-wallwars/models_*/
# Local training experiments contain large generated datasets and model files.
/deep-wallwars/training-runs/
bot-4-debug.log
.cache/
logs/*
deep-wallwars/assets/models/*.pt
deep-wallwars/assets/models/*.onnx
# Engine game dumps used as local fixtures. frontend/public/ is copied verbatim
# into the build, so anything committed here becomes a public URL on the site.
frontend/public/replays/
# Private ops runbooks (bot restarts, the GPU desktop, deploys). They name
# private hostnames, secret file paths and token locations, and this repo is
# public, so they stay local. Keep them here, not in info/, which is tracked.
ops-private/

# Generated by scripts/game-video/make-stings.mjs, which is deterministic -
# the script is committed, the audio it builds is not.
/assets/stings/
