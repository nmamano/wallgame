# deps
node_modules/

dist/

.env
.env.prod
.wallgame-bot-heartbeat

ignore/
# Repo-root scratch space for local review artifacts and one-off evidence files.
# Anchored with a leading slash so it covers only this directory, not every folder
# named tmp elsewhere in the tree.
/tmp/
**/.tanstack/tmp/
.cursor/debug.log
.eslintcache
diff.txt
deep-wallwars/data_*/
deep-wallwars/logs/
deep-wallwars/models_*/
# Local training experiments contain large generated datasets and model files.
/deep-wallwars/training-runs/
bot-4-debug.log
.cache/
logs/*
deep-wallwars/assets/models/*.pt
deep-wallwars/assets/models/*.onnx
# Engine game dumps used as local fixtures. frontend/public/ is copied verbatim
# into the build, so anything committed here becomes a public URL on the site.
frontend/public/replays/
# Private ops runbooks (bot restarts, the GPU desktop, deploys). They name
# private hostnames, secret file paths and token locations, and this repo is
# public, so they stay local. Keep them here, not in info/, which is tracked.
ops-private/

# Generated by scripts/game-video/make-stings.mjs, which is deterministic -
# the script is committed, the audio it builds is not.
/assets/stings/
# Meme sound clips for the daily game videos (task e8d26610). Other people's
# uploads from public meme sound sites: kept on the render boxes, never in
# this public repository. Sources: scripts/game-video/meme-sounds.md.
/assets/meme-sounds/
# Overlay clips for the daily game videos (scripts/game-video/overlay-clips.mjs):
# PNG sequences of reaction cut-outs, other people's clips like the sounds.
/assets/overlays/
# The director's docs for the daily game videos (Nil, 2026-10-30: keep the
# director work local). They live in a separate local repo that is never
# pushed; crew.mjs reads them from there.
/scripts/game-video/daily/DIRECTOR.md
/scripts/game-video/daily/CASES.md
/scripts/game-video/daily/SCRIPT.md
/scripts/game-video/daily/SCRIPT-REVIEW.md
/scripts/game-video/daily/AFTER-RENDER.md
/scripts/game-video/daily/IMPLEMENT.md
/scripts/game-video/daily/VET-BRIEF.md
/scripts/game-video/meme-list.md
