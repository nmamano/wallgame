#!/usr/bin/env bash
set -e

# Make sure Bun is on PATH (Windows + Git Bash)
export PATH="$HOME/.bun/bin:$PATH"

# ----- No ignored path in a pushed commit -----
# Some files stay on this machine only: .gitignore lists them. A commit made
# before a path was ignored still holds it, so a push of an old branch (or a
# merge or plain rebase of one) would publish it again. This happened on
# 2026-10-30, when private docs left the unpushed history: every branch made
# before that still held them. So each pushed commit's whole tree is checked
# against the CURRENT .gitignore. About 6 s for 200 commits.
#
# POSIX sh: husky runs this file with `sh -e`, whatever the line on top says.
zero=0000000000000000000000000000000000000000
changed="" # every path the pushed commits change, for the game-video gate below
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # a branch deletion pushes no commit
  # A new branch, or a remote tip this clone does not have: check all that
  # origin/main does not have.
  base=refs/remotes/origin/main
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base=$remote_sha
  fi
  if ! commits=$(git rev-list --reverse "$base..$local_sha"); then
    echo "❌❌ Push refused: cannot list the commits of $local_ref ($base..$local_sha)."
    exit 1
  fi
  # A diff that fails (no common base) counts as a game-video change.
  changed="$changed
$(git diff --name-only "$base...$local_sha" || echo scripts/game-video/)"
  for commit in $commits; do
    ignored=$(git ls-tree -r --name-only "$commit" | git check-ignore --no-index --stdin || true)
    if [ -n "$ignored" ]; then
      echo "❌❌ Push refused: $local_ref -> $remote_ref holds files that .gitignore keeps local."
      echo "Commit $(git log -1 --format='%h %s' "$commit") has:"
      echo "$ignored" | sed 's/^/  /'
      echo "Move the branch's own commits onto main without them, for example"
      echo "'git rebase --onto main <old base> <branch>' or cherry-pick."
      exit 1
    fi
  done
done
echo "✅✅ No pushed commit holds an ignored path."

# These are the SAME commands .github/workflows/ci.yml runs, deliberately. A
# local gate that only approximates the remote one drifts from it, and then a
# green push still fails CI - which is exactly what happened on 2026-08-08.
#
# INTEGRATION tests are left to CI. They need Docker (each integration file
# starts its own Postgres through Testcontainers) and take minutes, which is too
# much to put in front of every push. That is a considered split, not an
# oversight: `bun run test` is what catches a broken integration test remotely.
#
# tests/game/ is different and used to be swept up in that split by mistake. It
# needs no Docker and runs 477 tests in about 4 seconds, so leaving it to CI
# bought nothing and cost a red main: on 2026-08-20 e6968725 changed the served
# model to 116 without updating the guard in tests/game/bot-config-guards.test.ts,
# pushed green here, and main stayed red until 2026-08-21. Four seconds would
# have caught it.
#
# The scripts/game-video tests are the same kind, but slower; see the gate
# below the tests/game run.
#
# This is a SUBSET, not a substitute. A green hook still does not mean green CI -
# the integration suite has not run yet at this point.

# The checks read the tree and none depends on another, so they run at the
# same time (task dcfd6114, 2026-11-06): one after another they took about
# 5 minutes, long enough for GitHub to drop the idle SSH connection of the
# push. Each check has its own log; only the log of a failed check is shown,
# and any failure stops the push. The wall time is now about that of ESLint,
# the longest check.
#
# Not `bun run lint`: that one passes --fix, so it would REPAIR a violation and
# report success, leaving the unfixed version to be the thing that was pushed.
# `lint:check` is the checking form, and it is what CI runs too. `typecheck`
# covers six projects (server+shared, tests, scripts, harness, frontend tests,
# bot client), also at the same time.
set -- \
  "Prettier" "bun run format:check" \
  "ESLint" "bun run lint:check" \
  "Typecheck" "bun run typecheck" \
  "Unit tests (tests/game)" "bun test tests/game/" \
  "Build" "bun run build"

# scripts/game-video tests: CI runs them, and until 2026-11-04 nothing ran
# them before a push. They need no Docker, but they take about 70 s on
# auntie-2 even 4 at a time (daily/daily.test.ts alone takes most of it), so
# they run only when the pushed commits change scripts/game-video/ or the
# code it imports from outside it (shared/, server/db/, and two files:
# frontend/src/lib/player-colors, official-custom-bot-client/src/config-schema).
# Add a path here when that code imports a new one. A push of other work skips
# them. Not `bun test --changed`: many of these tests run their script as a
# child process (node crew.mjs ...), which an import graph does not see.
# A machine that cannot run them (no ffmpeg, or a Node older than 22.18, as
# on the 4090 desktop) skips them with the reason, and CI runs them; see
# scripts/game-video/README.md.
#
# Here each test gets 30 s, not bun's default 5 s. These tests start child
# processes, and in this hook they share the CPU with the other checks: on
# 2026-11-06 a good push failed when 3 of them went over 5 s (auntie-2 load
# about 10), and alone two of them took more than 1.5 s at load 6. In this
# group the suite ends before ESLint, so the longer limit adds no wall time.
# A real hang still fails, only later. CI keeps the 5 s default.
if ! printf '%s\n' "$changed" | grep -qE '^((scripts/game-video|shared|server/db)/|frontend/src/lib/player-colors|official-custom-bot-client/src/config-schema)'; then
  echo "🎬🎬 Skipping the scripts/game-video tests: the push does not change that code."
elif ! command -v ffmpeg >/dev/null 2>&1; then
  echo "⚠️⚠️ Skipping the scripts/game-video tests: no ffmpeg on PATH. CI runs them."
elif ! node --input-type=module -e 'process.exit(import.meta.main ? 0 : 1)' >/dev/null 2>&1; then
  echo "⚠️⚠️ Skipping the scripts/game-video tests: they need Node 22.18 or later. CI runs them."
else
  echo "🎬🎬 The push changes scripts/game-video code, so its tests run too."
  set -- "$@" "scripts/game-video tests" "bun test --parallel=4 --timeout=30000 scripts/game-video"
fi

echo "🔎🔎 Running the checks at the same time (each has its own log; only a failed check shows it)..."
sh scripts/run-parallel.sh "$@"

echo "✅✅ All checks passed – push allowed."
