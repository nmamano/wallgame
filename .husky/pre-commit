#!/usr/bin/env bash
set -e

# Make sure Bun is on PATH (Windows + Git Bash)
export PATH="$HOME/.bun/bin:$PATH"

echo "🔍🔍 Collecting staged files..."

# Get paths of files with staged changes (Added, Copied, Modified, Renamed)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR || true)

if [ -z "$STAGED_FILES" ]; then
  echo "No staged files – skipping pre-commit checks."
  exit 0
fi

echo "Staged files:"
echo "$STAGED_FILES"
echo

# ----- Prettier -----
# No extension list. There used to be one, and it did not include .mjs - so a
# .mjs file was committed unformatted, pushed, and failed CI (run 31271384297,
# 2026-08-08) on the one check that was supposed to run right here. A hand-kept
# list of what Prettier handles drifts from what Prettier actually handles.
# --ignore-unknown lets Prettier answer that question itself, and it is the same
# answer `prettier --check .` gives in CI.
echo "🔍🔍 Running Prettier check on staged files..."
# NOTE: This checks only the staged files' current on-disk contents.
echo "$STAGED_FILES" | xargs bunx prettier --check --ignore-unknown

echo

# ----- ESLint: only on staged code files -----
# ESLint has no --ignore-unknown, so this list stays - but a file the config
# does not cover is now skipped quietly instead of failing the commit, which is
# what lets the list be generous rather than exact.
LINTABLE_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx|mjs|cjs|mts|cts)$' || true)

if [ -n "$LINTABLE_FILES" ]; then
  echo "🔎🔎 Running ESLint on staged files..."
  echo "$LINTABLE_FILES" | xargs bunx eslint --no-warn-ignored
else
  echo "No staged files need ESLint."
fi

echo
echo "✅✅ Pre-commit checks passed – commit allowed."
