# Config for scripts/bot-monitor.sh. Copy to ~/.wallgame-monitor.env and fill in.
#
# This file is deliberately NOT in the repo: it holds a secret (the webhook) and
# host-specific values (which machine the bot client runs on). The repo is
# public, so nothing here should ever be committed.
#
#   cp scripts/bot-monitor.env.example ~/.wallgame-monitor.env
#   chmod 600 ~/.wallgame-monitor.env
#
# Override the location with WALLGAME_MONITOR_CONFIG if you keep it elsewhere.

# Discord webhook the alerts go to. Without this the monitor still runs and
# still exits non-zero, but alerts only reach stdout and the systemd journal.
DISCORD_WEBHOOK_URL=

# Isomux webhook that wakes an agent on each alert: the hook URL, and a 0600
# file that holds only its secret. Leave either empty to skip it.
#WALLGAME_MONITOR_ISOMUX_HOOK_URL=http://localhost:4000/hooks/<hook id>
#WALLGAME_MONITOR_ISOMUX_HOOK_SECRET_FILE=$HOME/nil/secrets/<file>

# ssh target hosting the bot client, e.g. user@host. Leave EMPTY to alert only
# and never auto-restart. The monitor should run on a DIFFERENT machine from
# this one, so it survives that host going down.
WALLGAME_BOT_HOST=

# The bot client's log on that host, relative to the login directory. The
# monitor reads only what it gained since the last run, for engine crashes.
#WALLGAME_BOT_LOG=logs/bot-client-transformer.log

# How to restart the bot client on that host. The default assumes a systemd
# user unit, which needs no sudo - see scripts/wallgame-bot.service.
#WALLGAME_BOT_RESTART_CMD="systemctl --user restart wallgame-bot"

# Site to poll. Only change this to test against a staging deployment.
#WALLGAME_API_BASE=https://wallgame.io

# Consecutive failed checks before declaring the bots DOWN. Debounces blips.
#WALLGAME_MONITOR_FAIL_THRESHOLD=2

# Seconds between restart attempts, so a bot that cannot come back is not
# restarted on every run forever.
#WALLGAME_MONITOR_RESTART_COOLDOWN=1800

# A check of the bot listings slower than this (milliseconds) counts as slow.
# Alerts go out on the change only: 2 slow checks in a row, still slow after
# SLOW_REMIND_RUNS checks in a row, and fast again (only after a "slow").
#WALLGAME_MONITOR_SLOW_MS=10000
# SLOW_REMIND_RUNS must be greater than 2 (the 2 checks that confirm "slow").
#WALLGAME_MONITOR_SLOW_REMIND_RUNS=6

# Where the up/down state is kept between runs. The crash alarm keeps the log
# position it already read in a file beside it (.crash-offset).
#WALLGAME_MONITOR_STATE="$HOME/.local/state/wallgame-bot-monitor.state"
