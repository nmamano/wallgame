{
  "name": "server",
  "module": "server/index.ts",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "start": "bun run server/index.ts",
    "dev": "FRONTEND_URL=http://localhost:5173 bun run --hot server/index.ts",
    "migrate": "bun scripts/migrate.ts",
    "test": "bun scripts/run-tests.ts",
    "test:wsl": "wsl.exe -d Ubuntu -- bash -lc 'cd \"$PWD\" && env PATH=\"$HOME/.bun/bin:/usr/bin:/bin\" bun scripts/run-tests.ts'",
    "typecheck": "bun x tsc --noEmit -p tsconfig.server.json && bun x tsc --noEmit -p tsconfig.tests.json && bun x tsc --noEmit -p tsconfig.scripts.json && bun x tsc --noEmit -p tsconfig.harness.json && bun x tsc --noEmit -p frontend/tsconfig.test.json && bun x tsc --noEmit -p official-custom-bot-client/tsconfig.json",
    "build": "bun --cwd=frontend run build",
    "harness:nudge": "bun run build && bun scripts/browser-harness/drive-account-nudge.ts",
    "harness:puzzles": "bun run build && bun scripts/browser-harness/drive-puzzles-page.ts",
    "harness:campaign": "bun run build && bun scripts/browser-harness/drive-campaign-progress.ts",
    "harness:bots": "bun run build && bun scripts/browser-harness/drive-bots-empty-state.ts",
    "harness:pwa": "bun run build && bun scripts/browser-harness/drive-pwa-manifest.ts",
    "harness:username": "bun run build && bun scripts/browser-harness/drive-username-picker.ts",
    "harness:game-help": "bun run build && bun scripts/browser-harness/drive-game-help.ts",
    "format": "bun x prettier --write .",
    "format:check": "bun x prettier --check .",
    "lint": "NODE_OPTIONS=--max-old-space-size=4096 bun x eslint . --fix --cache --cache-location .eslintcache",
    "lint:check": "NODE_OPTIONS=--max-old-space-size=4096 bun x eslint .",
    "ci": "bun x prettier --check . && bun run lint:check && bun run typecheck && bun run test && bun run build",
    "cip": "bun x prettier --write . && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@fontsource/cormorant": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@kinde-oss/kinde-typescript-sdk": "^2.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "nanoid": "^5.1.16",
    "obscenity": "^0.4.6",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/bun": "^1.4.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "prettier": "3.8.3",
    "testcontainers": "^12.2.1",
    "typescript-eslint": "^8.48.0"
  },
  "trustedDependencies": [
    "protobufjs"
  ]
}
